# ---- Núcleo / rede ----
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL="https://core.streammonitor.site"

# ---- Core AWS (motor de monitoramento) ----
# No painel Lovable: aponta para o Core. Na própria VPS: mantenha IS_CORE=true
CORE_API_URL="https://core.streammonitor.site"
VITE_CORE_API_URL="https://core.streammonitor.site"
IS_CORE=true

# ---- Agendamento do monitoramento ----
CRON_SECRET="gere-um-valor-aleatorio-forte"
CRON_INTERVAL_SECONDS=30

# ---- Controle de carga das verificações (anti-bloqueio) ----
MONITOR_CONCURRENCY=8          # verificações simultâneas de DNS/HTTP
MONITOR_JITTER_MS=250          # atraso aleatório entre disparos
MONITOR_MAX_RETRIES=1          # novas tentativas por verificação

# ---- Integrações ----
TELEGRAM_BOT_TOKEN=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
REGION_WORKER_SECRET=""
TMDB_API_KEY=""
KUMA_BASE_URL=""
KUMA_USERNAME=""
KUMA_PASSWORD=""
